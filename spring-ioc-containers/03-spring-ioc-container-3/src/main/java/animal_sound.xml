<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd
            http://www.springframework.org/schema/context
            http://www.springframework.org/schema/context/spring-context-3.0.xsd">

	<bean id="animalsoundlion" class="org.jsp.animal.AnimalSound">
		<property name="animal" ref="lion"></property>
	</bean>
	
	<bean id="animalsounddog" class="org.jsp.animal.AnimalSound">
		<property name="animal" ref="dog"></property>
	</bean>
	
	<bean id="dog" class="org.jsp.animal.Dog">
	</bean>
	
	<bean id="lion" class="org.jsp.animal.Lion">
	</bean>
</beans>