<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd
            http://www.springframework.org/schema/context
            http://www.springframework.org/schema/context/spring-context-3.0.xsd">

    <bean id="student" class="org.jsp.spring_ioc_container2.setter_injection.Student">
    	<property name="name" value="Imamuddin"></property>
    	<property name="address" value="Bihar"></property>
    	<property name="marks" value="55"></property>
    	<property name="bike" ref="mybike"></property>
    </bean>

    <bean id="mybike" class="org.jsp.spring_ioc_container2.setter_injection.Bike">
    	<property name="brand" value="Hero"></property>
    	<property name="cost" value="97000.00"></property>
    	<property name="color" value="Black"></property>
    </bean>

</beans>